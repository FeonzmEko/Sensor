<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <TextView
            android:id="@+id/titleTv"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="多元感知融合 · 传感器监听器"
            android:textSize="18sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/statusTv"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:fontFamily="monospace"
            android:text="等待传感器数据…"
            android:textSize="13sp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/helloWorldBtn"
            style="?attr/materialButtonOutlinedStyle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="@string/hello_world_open" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:orientation="horizontal">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/startRecordingBtn"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:enabled="false"
                android:text="开始采集" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/stopRecordingBtn"
                style="?attr/materialButtonOutlinedStyle"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:layout_weight="1"
                android:enabled="false"
                android:text="停止采集" />
        </LinearLayout>

        <TextView
            android:id="@+id/recordingStatusTv"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:background="#11000000"
            android:fontFamily="monospace"
            android:padding="8dp"
            android:text="尚未开始采集。正式采集时请保持本页面在前台。"
            android:textSize="12sp" />

        <TextView
            android:id="@+id/sensorNamesTv"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:fontFamily="monospace"
            android:text="加速度计：检测中…\n陀螺仪：检测中…"
            android:textSize="12sp" />

        <com.example.sensorlog.WaveformView
            android:id="@+id/waveform"
            android:layout_width="match_parent"
            android:layout_height="240dp"
            android:layout_marginTop="8dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="实时加速度波形 · 红X 绿Y 蓝Z（纵轴 m/s²，窗口 8 s）｜平放静止时 Z≈9.8"
            android:textSize="11sp" />

        <TextView
            android:id="@+id/valuesTv"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:fontFamily="monospace"
            android:text="加速度（m/s²）：X=0.00  Y=0.00  Z=0.00  |a|=0.00\n陀螺仪（rad/s）：X=0.000  Y=0.000  Z=0.000  |ω|=0.000"
            android:textSize="13sp" />

        <TextView
            android:id="@+id/sensorsTv"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:fontFamily="monospace"
            android:textSize="10sp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="说明：GAME 档位申请，实际频率以文件时间戳实测为准；e.values 为机体系分量；页面进入后台时会自动停止并关闭文件。"
            android:textSize="11sp" />
    </LinearLayout>
</ScrollView>