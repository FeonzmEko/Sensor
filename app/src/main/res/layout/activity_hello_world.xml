<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:padding="24dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:orientation="vertical">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Hello World"
            android:textSize="36sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/helloSensorTv"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="正在读取加速度计…"
            android:textSize="16sp" />

        <TextView
            android:id="@+id/helloValuesTv"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="32dp"
            android:fontFamily="monospace"
            android:text="X = --&#10;Y = --&#10;Z = --"
            android:textSize="28sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/helloStatusTv"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:fontFamily="monospace"
            android:text="Hello World · 等待传感器回调…"
            android:textSize="15sp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:text="单位：m/s²\n坐标：Android 设备机体系 X/Y/Z\n申请档位：SENSOR_DELAY_GAME"
            android:textSize="13sp" />
    </LinearLayout>
</FrameLayout>